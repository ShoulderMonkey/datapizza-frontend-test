    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Very simple mock login endpoint.\n\nIt just sets a `user_id` cookie that the rest of the API\nwill use to authenticate the user. There is no password\nor registration logic by design for this test.\n\nReturns 422 if user_id is invalid (empty, too long, or contains invalid characters).",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
